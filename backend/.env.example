NODE_ENV=development
PORT=3001

# Banco (Postgres). Com o docker-compose da raiz, estes valores já funcionam.
DB_HOST=localhost
DB_PORT=5432
DB_USER=csm
DB_PASSWORD=csm_dev_pass
DB_NAME=csm_gestao
# Schema próprio (criado automaticamente). Permite dividir o mesmo Postgres com outro sistema.
DB_SCHEMA=csm

# Origem do frontend (CORS). Em dev o Vite faz proxy de /api, então CORS quase não é usado.
FRONTEND_URL=http://localhost:5173

# Cookie de sessão: em produção com HTTPS deixe true.
COOKIE_SECURE=false
# Tempo de sessão por inatividade, em minutos (SAE usa 40).
SESSION_MINUTES=40

# Usuário administrador criado pelo db:setup
SEED_ADMIN_EMAIL=admin@csm.local
SEED_ADMIN_PASSWORD=Admin@123

# ---------- Assinatura eletrônica (Autentique) ----------
# Token da API: painel do Autentique > Configurações > API. Sem token o sistema usa o modo SIMULADO (só desenvolvimento).
AUTENTIQUE_KEY=
# true = documentos de teste (não consomem crédito e são apagados em alguns dias). Em produção use false.
AUTENTIQUE_SANDBOX=true
# Tipo de assinatura permitido na tela do Autentique: DRAW (desenhar com o dedo) | HANDWRITING | ELECTRONIC | IMAGE
AUTENTIQUE_ASSINATURA=DRAW
# Recomendado p/ só selfie (sem foto de documento): PF_FACIAL. Foto do rosto na assinatura (consome créditos extras): LIVE (documento+selfie+prova de vida) | MANUAL (documento+selfie, escola aprova) | PF_FACIAL (só selfie validada no CPF) | deixe vazio para desligar
AUTENTIQUE_VERIFICACAO=
# Por padrão a foto do rosto é pedida só no contrato (economiza créditos). true = pedir também nos 2 termos
AUTENTIQUE_VERIFICAR_TERMOS=false
# Segredo do webhook (opcional; exige URL pública). Sem webhook o sistema atualiza sozinho a cada 15 s na tela da matrícula.
AUTENTIQUE_WEBHOOK_SECRET=
# Caminho do LibreOffice (converte .docx em PDF antes do envio). No Windows: C:\Program Files\LibreOffice\program\soffice.exe
SOFFICE_PATH=soffice

# Chave para cifrar a senha SMTP e os links de rematrícula guardados no banco. Defina um texto longo e aleatório em produção.
APP_SECRET=
# Endereço público do sistema (usado no link enviado aos pais). Ex.: https://gestao.colegiosaomateus.com.br
# FRONTEND_URL=
